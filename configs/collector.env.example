# HyWeCollector environment (data collection, Stages 1-4 + export).
# Copy to configs/collector.env, fill in the blanks, then `source configs/collector.env`.
#
# Every LLM role defaults to one model behind one OpenAI-compatible endpoint.
# Recommended: kimi-k3 (vision is required for the explorer, fact extractor,
# executor, controller, unified audit and the O-segment purity judge). The paper
# used Kimi-K3 and Qwen3.8-Max; override any role below to mix models.

export COLLECTOR_BASE_URL="http://127.0.0.1:8000/v1"
export COLLECTOR_API_KEY="EMPTY"
export COLLECTOR_MODEL="kimi-k3"

# ---- web tools (same as inference) ---------------------------------------------
export SERPER_API_KEY=""                 # search + scholar
export JINA_API_KEY=""                   # visit (r.jina.ai) + task-design embeddings
export HYBRID_SEARCH_BACKEND="serper"     # capability probing
export CODE_SANDBOX_BASE_URL="http://127.0.0.1:8080"
export TASK_PROXY_URL=""                 # optional HTTP proxy for the browser

# ---- Stage 1: capability probing --------------------------------------------------
export EXPLORER_API_BASE="$COLLECTOR_BASE_URL"  EXPLORER_API_KEY="$COLLECTOR_API_KEY"  EXPLORER_MODEL="$COLLECTOR_MODEL"
export FACT_API_BASE="$COLLECTOR_BASE_URL"      FACT_API_KEY="$COLLECTOR_API_KEY"      FACT_MODEL="$COLLECTOR_MODEL"
export FACT_TRAJ_SHOTS=1                        # extractor sees current + 1 previous screenshot
export PROBE_AGENT_BASE="$COLLECTOR_BASE_URL"   PROBE_AGENT_KEY="$COLLECTOR_API_KEY"   PROBE_AGENT_MODEL="$COLLECTOR_MODEL"
export PROBE_FLASH_BASE="$COLLECTOR_BASE_URL"   PROBE_API_KEY="$COLLECTOR_API_KEY"     PROBE_FLASH_MODEL="$COLLECTOR_MODEL"
export PROBE_MAX_ITER=8                         # probe budget B (search-agent steps per fact)
export SYNTH_BASE="$COLLECTOR_BASE_URL"         SYNTH_API_KEY="$COLLECTOR_API_KEY"     SYNTH_MODEL="$COLLECTOR_MODEL"
export VALUE_FILTER_MODEL="$COLLECTOR_MODEL"
export PIPE_T_A=1800                            # per-site explorer wall clock (s)
export PIPE_T_B=5400                            # per-site probe wall clock (s)
export STAGE1_RUN_DIR="runs/stage1"

# ---- visit summarizer (all stages) ------------------------------------------------
export SUMMARY_BASE_URL="$COLLECTOR_BASE_URL"   SUMMARY_API_KEY="$COLLECTOR_API_KEY"   SUMMARY_MODEL="$COLLECTOR_MODEL"

# ---- Stage 3: executor + controller (teacher rollout) ------------------------------
export TEACHER_BASE_URL="$COLLECTOR_BASE_URL"   TEACHER_API_KEY="$COLLECTOR_API_KEY"   TEACHER_MODEL="$COLLECTOR_MODEL"
export PHASE_VERIFIER_MODEL="$COLLECTOR_MODEL"

# ---- Stage 4: reviewers / refiners, loss-mask judges -----------------------------
export JUDGE_BASE_URL="$COLLECTOR_BASE_URL"     JUDGE_API_KEY="$COLLECTOR_API_KEY"     JUDGE_MODEL="$COLLECTOR_MODEL"
