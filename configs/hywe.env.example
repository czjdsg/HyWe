# HyWe inference / evaluation environment.
# Copy to configs/hywe.env, fill in the blanks, then `source configs/hywe.env`.
# CLI options and environment-only runtime settings are documented below.

# ---- policy model (OpenAI-compatible endpoint, e.g. vLLM) --------------------
export BASE_URL="http://127.0.0.1:8000/v1"
export MODEL="HyWe-35B"                 # --served-model-name of your server
export API_KEY="EMPTY"

# ---- `visit` summarizer: extracts goal-relevant text from fetched pages ------
# The paper used deepseek-v4-flash; any OpenAI-compatible chat model works.
export SUMMARY_BASE_URL="$BASE_URL"
export SUMMARY_MODEL="$MODEL"
export SUMMARY_API_KEY="$API_KEY"

# ---- web tools ----------------------------------------------------------------
export SERPER_API_KEY=""                # https://serper.dev  (search + scholar)
export JINA_API_KEY=""                  # https://jina.ai     (visit: r.jina.ai reader)
# Archived paper evaluation launchers used Jina Search; the paper text names
# Serper. Default to the archived run configuration; use "serper" to select
# Serper as described in the appendix. `scholar` always uses Serper.
export HYBRID_SEARCH_BACKEND="jina"

# ---- code sandbox (tools/local_sandbox or any SandboxFusion /run_code server) --
export CODE_SANDBOX_BASE_URL="http://127.0.0.1:8080"

# ---- browser egress (optional) ---------------------------------------------------
# HTTP proxy for the Playwright browser; empty = direct.
export TASK_PROXY_URL=""

# ---- HyWe runtime parameters used for the paper (Appendix, Table "runtime") ----
export HYBRID_V2_RENDER="multiturn"     # segment-wise multi-turn rendering
export HYBRID_DISABLE_THINKING=0        # reasoning enabled
export HYBRID_FOLD_HIGH=131072          # fold trigger watermark (tokens)
export HYBRID_FOLD_LOW=65536            # fold-down target (tokens)
export HYBRID_MAX_INPUT_TOKENS=224000   # serving window; trigger = min(HIGH, this) - (max_tokens + 256)
# Tokenizer used to count context tokens for folding (HF repo id or local path).
export HYBRID_TOKENIZER_PATH="yzxjb/HyWe-35B"
# Search-side loop guard (identical call fingerprint repeated K times).
export HYBRID_LOOP_MAX_REPEAT=5
export HYBRID_LOOP_COLLAPSE_MIN=3
export HYBRID_LOOP_TOOLS="search,scholar,visit,code_sandbox"
export HYBRID_LOOP_FORCE_FINAL_AFTER=10
# Retries for transient LLM / summarizer errors (429, 5xx, timeouts).
export HYBRID_LLM_MAX_ATTEMPTS=6
export HYBRID_LLM_BACKOFF_CAP=60

# ---- images sent to the model --------------------------------------------------
# base64 (default) inlines screenshots. For remote endpoints with request-size
# limits use url: images are copied into HYBRID_IMAGE_PUBLISH_DIR, which you serve
# over HTTPS at HYBRID_IMAGE_URL_BASE.
export HYBRID_IMAGE_TRANSPORT="base64"
# export HYBRID_IMAGE_PUBLISH_DIR="/path/to/public/images"
# export HYBRID_IMAGE_URL_BASE="https://images.example.org/hywe"

# ---- ablations -------------------------------------------------------------------
# export HYBRID_V2_LOCK_SIDE=S   # search-based mode only (no switch)
# export HYBRID_V2_LOCK_SIDE=O   # operation-based mode only (no switch)
# export HYBRID_V2_FLAT=1        # "naive merging": all tools, one prompt, no switch

# ---- judges (evaluation/) ------------------------------------------------------
export JUDGE_BASE_URL=""                # OpenAI-compatible endpoint of the judge
export JUDGE_API_KEY=""
export JUDGE_MODEL="kimi-k3"
# Operation judges have separate model settings so MODEL remains the policy.
export M2W_JUDGE_MODEL="o4-mini"
export WV_JUDGE_MODEL="gpt-4o"
# export OPENAI_API_KEY=""              # operation judges
# export OPENAI_BASE_URL="https://api.openai.com/v1"
