# HybridWebAgent — production inference preference.
# Source this from a shell or pass through scripts/run_inference.sh.
#
#   source configs/inference.env
#   python inference/run_hybrid_web_agent.py \
#       --input-path benchmarks/data/operation/web_webvoyager_643_final.jsonl \
#       --base-url $BASE_URL --model $MODEL \
#       --routed-search-model $SEARCH_MODEL --routed-search-base-url $BASE_URL \
#       --routed-operation-model $MODEL --routed-operation-base-url $BASE_URL \
#       --router-model $ROUTER_MODEL --router-base-url $BASE_URL \
#       --summary-base-url $SUMMARY_BASE_URL --summary-model $SUMMARY_MODEL \
#       --code-sandbox-base-url $CODE_SANDBOX_BASE_URL \
#       --headless
#
# Everything below mirrors the production v8 wiring on 47.82.159.100:8000.
# Override any single value AFTER sourcing this file.

# ----- main inference endpoint (one host, port :8000) -----
export BASE_URL="${BASE_URL:-http://47.82.159.100:8000/v1}"
export API_KEY="${API_KEY:-EMPTY}"

# Operator (vision; emits coordinates). coord-scale auto-resolves to 1000.
export MODEL="${MODEL:-qwen3.7-plus}"

# Routed S-side / O-side / router roles all live on :8000.
export SEARCH_MODEL="${SEARCH_MODEL:-qwen3.7-max}"
export ROUTER_MODEL="${ROUTER_MODEL:-kimi-k2.6}"

# Visit-summary (also on :8000 — single endpoint per user preference).
export SUMMARY_BASE_URL="${SUMMARY_BASE_URL:-http://47.82.159.100:8000/v1}"
export SUMMARY_MODEL="${SUMMARY_MODEL:-deepseek-v4-flash}"
export SUMMARY_API_KEY="${SUMMARY_API_KEY:-$API_KEY}"

# Code sandbox: local in-process server (tools/local_sandbox/server.py).
# Start with scripts/start_sandbox.sh and it listens on 127.0.0.1:8080.
export CODE_SANDBOX_BASE_URL="${CODE_SANDBOX_BASE_URL:-http://127.0.0.1:8080}"

# Local key-rotation pools.
export SERPER_BASE_URL="${SERPER_BASE_URL:-http://127.0.0.1:8765}"
export JINA_READER_BASE_URL="${JINA_READER_BASE_URL:-http://127.0.0.1:8766}"

# Outbound proxy used by the browser (vendored clash listens on :8990).
# Comment out or set empty to go direct.
export TASK_PROXY_URL="${TASK_PROXY_URL:-http://127.0.0.1:8990}"
