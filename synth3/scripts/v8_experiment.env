# synth3 experiment configuration — the model topology and endpoints that
# produced the production v8 run on 47.82.159.100. Source this from a launch
# script before invoking pipeline_driver.py:
#
#   source /data/czj/HybridWebAgent_release/synth3/scripts/v8_experiment.env
#   bash /data/czj/HybridWebAgent_release/synth3/scripts/v8_full1170_launch.sh
#
# Anything you want to override (a different endpoint, a swapped-in model)
# can be `export`-ed AFTER sourcing this file.

# ---- endpoints --------------------------------------------------------------
# Two endpoints, separate model fleets:
#   :8000  qwen3.7-plus / qwen3.7-max (vision + text)
#   :8002  kimi-k2.6 (vision + text), aws.claude-opus-4-7 (text), deepseek-v4-flash
export _SYN_HOST_8000="http://47.82.159.100:8000/v1"
export _SYN_HOST_8002="http://47.82.159.100:8002/v1"

# ---- A stage ---------------------------------------------------------------
# Operator: qwen3.7-plus on :8000. Outputs 0-1000 logical pixel coords.
export EXPLORER_MODEL="qwen3.7-plus"
export EXPLORER_API_BASE="$_SYN_HOST_8000"
export EXPLORER_API_KEY="qazxswedcvfrtgbnhy"
# Fact extractor: kimi-k2.6 on :8002 (vision-capable, judges walled pages).
export FACT_MODEL="kimi-k2.6"
export FACT_API_BASE="$_SYN_HOST_8002"
export FACT_API_KEY="qazxswedcvfrtgbnhy"
# Explorer router knobs
export SYNTH3_AGENT="v8"            # decoupled operator + fact extractor
export EXPLORE_DRY="20"             # let qwen burn through housekeeping turns
                                    # before the saturation router stops it

# ---- B stage (fact_prober_v2 search agent) ---------------------------------
export PROBE_AGENT_BASE="$_SYN_HOST_8000"
export PROBE_AGENT_MODEL="qwen3.7-max"
export PROBE_AGENT_KEY="qazxswedcvfrtgbnhy"

# ---- C stage (task_synth) --------------------------------------------------
# aws.claude-opus-4-7 is text-only — feed it the probed fact table, get a JSON
# task set back. vertex_ai.claude-* paths were 503/down at experiment time.
export SYNTH_MODEL="aws.claude-opus-4-7"
export SYNTH_BASE="$_SYN_HOST_8002"
export SYNTH_API_KEY="qazxswedcvfrtgbnhy"

# ---- R stage (hybrid_guided_routed rollout) --------------------------------
# Operator and search routes intentionally match the model used in production
# so the synthesized tasks are graded by the same agent that would deploy.
export R_OPERATION_MODEL="qwen3.7-plus"
export PIPE_BASE_URL="$_SYN_HOST_8000"           # operator endpoint
export PIPE_VISION_BASE_URL="$_SYN_HOST_8002"    # router + summary endpoint
export PIPE_ROUTER_MODEL="kimi-k2.6"
export PIPE_SEARCH_MODEL="qwen3.7-max"
export PIPE_SUMMARY_MODEL="deepseek-v4-flash"
export PIPE_API_KEY="qazxswedcvfrtgbnhy"

# ---- visit summary (shared between A and B's visit tool) -------------------
export SUMMARY_BASE_URL="$_SYN_HOST_8002"
export SUMMARY_MODEL="deepseek-v4-flash"
export SUMMARY_API_KEY="qazxswedcvfrtgbnhy"

# ---- shared search / read pools (REQUIRED for B stage) ---------------------
export SERPER_BASE_URL="${SERPER_BASE_URL:-http://127.0.0.1:8765}"
export JINA_READER_BASE_URL="${JINA_READER_BASE_URL:-http://127.0.0.1:8766}"

# ---- proxy (REQUIRED — sites region-wall direct connections) ---------------
# explorer_runtime + R-stage browser read this. Set to "" if you don't have a
# local egress proxy and want to risk going direct.
export PROXY_URL="${PROXY_URL:-${TASK_PROXY_URL:-http://127.0.0.1:8990}}"
export PIPE_PROXY_URL="$PROXY_URL"

# ---- per-stage hard caps (override if endpoints are slower / faster) -------
export PIPE_T_A="${PIPE_T_A:-9000}"      # 150 min — qwen + kimi vision is slow
export PIPE_T_B="${PIPE_T_B:-2400}"      # 40 min
export PIPE_T_C="${PIPE_T_C:-1800}"      # 30 min
export PIPE_T_R="${PIPE_T_R:-9000}"      # 150 min
